{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "${env:LOCALAPPDATA}/Microsoft/dotnet/dotnet.exe",
      "args": ["build", "${workspaceFolder}/Backrooms.csproj", "-c", "Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package release zip",
      "type": "process",
      "command": "${env:LOCALAPPDATA}/Microsoft/dotnet/dotnet.exe",
      "args": ["build", "${workspaceFolder}/Backrooms.csproj", "-c", "Release"],
      "problemMatcher": "$msCompile"
    }
  ]
}
