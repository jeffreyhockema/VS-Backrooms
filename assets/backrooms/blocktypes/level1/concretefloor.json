{
	code: "concretefloor",
	// "line" variants carry painted stall lines, "dash" variants the yellow aisle centre line
	variantgroups: [{ code: "type", states: ["plain", "wet", "dark", "linens", "linewe", "dashwe", "dashns"] }],
	creativeinventory: { "general": ["*"], "construction": ["*"] },
	blockmaterial: "Stone",
	drawtype: "cube",
	// Plain, wet and dark concrete in three versions each (the crack and scuff, the mould, the film of water in
	// different places), all turned at random; the painted lines keep their direction
	texturesByType: {
		"*-plain": { all: { base: "block/level1/concretefloor-plain", alternates: [{ base: "block/level1/concretefloor-plain", rotation: 90 }, { base: "block/level1/concretefloor-plain", rotation: 180 }, { base: "block/level1/concretefloor-plain", rotation: 270 }, { base: "block/level1/concretefloor-plain-2" }, { base: "block/level1/concretefloor-plain-2", rotation: 90 }, { base: "block/level1/concretefloor-plain-2", rotation: 180 }, { base: "block/level1/concretefloor-plain-2", rotation: 270 }, { base: "block/level1/concretefloor-plain-3" }, { base: "block/level1/concretefloor-plain-3", rotation: 90 }, { base: "block/level1/concretefloor-plain-3", rotation: 180 }, { base: "block/level1/concretefloor-plain-3", rotation: 270 }] } },
		"*-wet": { all: { base: "block/level1/concretefloor-wet", alternates: [{ base: "block/level1/concretefloor-wet", rotation: 90 }, { base: "block/level1/concretefloor-wet", rotation: 180 }, { base: "block/level1/concretefloor-wet", rotation: 270 }, { base: "block/level1/concretefloor-wet-2" }, { base: "block/level1/concretefloor-wet-2", rotation: 90 }, { base: "block/level1/concretefloor-wet-2", rotation: 180 }, { base: "block/level1/concretefloor-wet-2", rotation: 270 }, { base: "block/level1/concretefloor-wet-3" }, { base: "block/level1/concretefloor-wet-3", rotation: 90 }, { base: "block/level1/concretefloor-wet-3", rotation: 180 }, { base: "block/level1/concretefloor-wet-3", rotation: 270 }] } },
		"*-dark": { all: { base: "block/level1/concretefloor-dark", alternates: [{ base: "block/level1/concretefloor-dark", rotation: 90 }, { base: "block/level1/concretefloor-dark", rotation: 180 }, { base: "block/level1/concretefloor-dark", rotation: 270 }, { base: "block/level1/concretefloor-dark-2" }, { base: "block/level1/concretefloor-dark-2", rotation: 90 }, { base: "block/level1/concretefloor-dark-2", rotation: 180 }, { base: "block/level1/concretefloor-dark-2", rotation: 270 }, { base: "block/level1/concretefloor-dark-3" }, { base: "block/level1/concretefloor-dark-3", rotation: 90 }, { base: "block/level1/concretefloor-dark-3", rotation: 180 }, { base: "block/level1/concretefloor-dark-3", rotation: 270 }] } },
		"*": { all: { base: "block/level1/concretefloor-{type}" } }
	},
	resistance: 8,
	requiredMiningTier: 3,
	lightAbsorption: 99,
	sounds: { walk: "game:walk/stone", place: "game:block/loosestone", break: "game:block/rock-break-pickaxe", hit: "game:block/rock-hit-pickaxe" }
}
