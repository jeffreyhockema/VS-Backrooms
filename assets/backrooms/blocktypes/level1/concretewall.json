{
	code: "concretewall",
	variantgroups: [{ code: "type", states: ["plain", "damaged"] }],
	creativeinventory: { "general": ["*"], "construction": ["*"] },
	blockmaterial: "Stone",
	// Damaged walls have rusty rebar sticking out of them
	drawtypeByType: { "*-damaged": "json", "*": "cube" },
	// (graphics pass D4) Versions picked by height as well as place, so a column of wall does not stack one version
	randomizeAxes: "xyz",
	shapeByType: { "*-damaged": { base: "block/concretewall-damaged" } },
	// Name only the wall code on the damaged shape: "all" would paint the rebar concrete too
	texturesByType: {
		"*-damaged": { wall: { base: "block/level1/concretewall-damaged" } },
		// Plain walls in three versions (the third with a crack and a rust run from a tie), not turned: the pour line
		// and the tie holes keep their place. The cracked one is listed once in eight (D1: it repeated too visibly)
		"*-plain": { all: { base: "block/level1/concretewall-plain", alternates: [{ base: "block/level1/concretewall-plain-2" }, { base: "block/level1/concretewall-plain" }, { base: "block/level1/concretewall-plain-2" }, { base: "block/level1/concretewall-plain" }, { base: "block/level1/concretewall-plain-2" }, { base: "block/level1/concretewall-plain" }, { base: "block/level1/concretewall-plain-3" }] } },
		"*": { all: { base: "block/level1/concretewall-{type}" } }
	},
	resistance: 8,
	requiredMiningTier: 3,
	lightAbsorption: 99,
	sounds: { walk: "game:walk/stone", place: "game:block/loosestone", break: "game:block/rock-break-pickaxe", hit: "game:block/rock-hit-pickaxe" }
}
