{
	code: "car",
	// An abandoned car, 2 blocks wide and 4 long. This corner block draws the whole model;
	// the rest of the footprint is carcollider blocks. "north" cars face north, "south" cars are turned around.
	// East- and west-facing cars (parked along Level 11's streets) are drawn from the corner the turned model needs:
	// an east-facing car from its east end on its north side, a west-facing one from its west end on its south side.
	// Level 1's are wrecks of the same car ("redwreck", "bluewreck", "whitewreck", and the black one "burnt" out).
	variantgroups: [
		{ code: "colour", states: ["red", "blue", "white", "black", "redwreck", "bluewreck", "whitewreck", "burnt"] },
		{ code: "side", states: ["north", "south", "east", "west"] }
	],
	creativeinventory: { "general": ["*-north"], "decorative": ["*-north"] },
	blockmaterial: "Metal",
	drawtype: "json",
	shapeByType: {
		"*-north": { base: "block/car-{colour}", rotateY: 0 },
		"*-south": { base: "block/car-{colour}", rotateY: 180 },
		"*-east": { base: "block/car-{colour}", rotateY: 270 },
		"*-west": { base: "block/car-{colour}", rotateY: 90 }
	},
	// Transparent pass: the tinted side glass shows the inside (seats, dashboard) through it
	renderpass: "Transparent",
	sidesolid: { all: false },
	sideopaque: { all: false },
	lightAbsorption: 0,
	resistance: 20,
	drops: [],
	sounds: { walk: "game:walk/stone", hit: "game:block/heavymetal-hit", break: "game:block/heavymetal-hit" }
}
