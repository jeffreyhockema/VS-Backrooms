{
	code: "conduitend",
	// The ends of Level 1's ceiling conduit (layout version 9 on, see WorldLayout.ConduitEnds): "end-<side>-<kind>" finishes a
	// run on that side, "stub-<axis>-<ends>" a length on its own, with an end at each side (the letters are the west end then
	// the east end of a "we" block, the south end then the north end of an "ns" one). cap: open space or a light beyond, with
	// a collar on each tube and a plate over both; box: it meets a wall or a beam, and goes into a junction box mounted on it.
	variantgroups: [{ code: "form", states: [
		"end-east-cap", "end-north-cap", "end-west-cap", "end-south-cap",
		"end-east-box", "end-north-box", "end-west-box", "end-south-box",
		"stub-we-cc", "stub-we-cb", "stub-we-bc", "stub-we-bb",
		"stub-ns-cc", "stub-ns-cb", "stub-ns-bc", "stub-ns-bb"
	] }],
	creativeinventory: { "general": ["*-end-east-cap", "*-end-east-box"], "decorative": ["*-end-east-cap", "*-end-east-box"] },
	blockmaterial: "Metal",
