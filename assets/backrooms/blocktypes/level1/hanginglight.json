		{ code: "state", states: ["on", "off", "flicker"] },
		{ code: "axis", states: ["we", "ns"] }
	],
	creativeinventory: { "general": ["*-we"], "decorative": ["*-we"] },
	blockmaterial: "Glass",
	drawtype: "json",
	shapeByType: {
		"*-off-we": { base: "block/hanginglight-off", rotateY: 0 },
		"*-off-ns": { base: "block/hanginglight-off", rotateY: 90 },
		"*-we": { base: "block/hanginglight-lit", rotateY: 0 },
		"*-ns": { base: "block/hanginglight-lit", rotateY: 90 }
	},
	lightHsvByType: { "*-on-*": [32, 1, 19] },
	entityClassByType: { "*-flicker-*": "BackroomsFlicker" },
	attributesByType: {
		"*-flicker-we": { offBlock: "backrooms:hanginglight-off-we" },
		"*-flicker-ns": { offBlock: "backrooms:hanginglight-off-ns" }
	},
	dropsByType: {
		"*-off-*": [{ type: "item", code: "glassshard", quantity: { avg: 1.5, var: 0.5 } }, { type: "item", code: "metalbracket", quantity: { avg: 0.12, var: 0 } }, { type: "item", code: "scrapwire", quantity: { avg: 0.3, var: 0 } }],
		"*-flicker-*": [{ type: "block", code: "hanginglight-off-we" }]
	},
	sidesolid: { all: false },
	sideopaque: { all: false },
	collisionbox: { x1: 0, y1: 0.45, z1: 0.3, x2: 1, y2: 1, z2: 0.7 },
	selectionbox: { x1: 0, y1: 0.45, z1: 0.3, x2: 1, y2: 1, z2: 0.7 },
	collisionboxByType: { "*-ns": { x1: 0.3, y1: 0.45, z1: 0, x2: 0.7, y2: 1, z2: 1 } },
	selectionboxByType: { "*-ns": { x1: 0.3, y1: 0.45, z1: 0, x2: 0.7, y2: 1, z2: 1 } },
