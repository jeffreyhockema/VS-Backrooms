{
	code: "pipes",
	// Overhead pipe bundles in the top block of a tunnel: straight runs, junction boxes, and hissing leaks. The tar
	// bundles are Level 3's: the bare pipe is black with the sludge it carries. "end-<side>" is a run ending with open
	// tunnel beyond it on that side, capped; "stub-<axis>" a length on its own, capped at both ends
	variantgroups: [{ code: "type", states: ["run-we", "run-ns", "hub", "leak-we", "leak-ns", "tar-we", "tar-ns", "tar-hub",
		"end-north", "end-east", "end-south", "end-west", "tar-end-north", "tar-end-east", "tar-end-south", "tar-end-west",
		"stub-we", "stub-ns", "tar-stub-we", "tar-stub-ns"] }],
	creativeinventory: { "general": ["*-run-we", "*-hub", "*-leak-we", "*-tar-we"], "decorative": ["*-run-we", "*-hub", "*-leak-we", "*-tar-we"] },
	blockmaterial: "Metal",
	drawtype: "json",
	shapeByType: {
		"*-hub": { base: "block/pipes-hub" },
		"*-end-east": { base: "block/pipes-end", rotateY: 0 },
		"*-end-north": { base: "block/pipes-end", rotateY: 90 },
		"*-end-west": { base: "block/pipes-end", rotateY: 180 },
		"*-end-south": { base: "block/pipes-end", rotateY: 270 },
		"*-stub-we": { base: "block/pipes-stub", rotateY: 0 },
		"*-stub-ns": { base: "block/pipes-stub", rotateY: 90 },
		"*-we": { base: "block/pipes-run", rotateY: 0 },
		"*-ns": { base: "block/pipes-run", rotateY: 90 }
	},
	texturesByType: {
		"*-tar-*": { rust: { base: "block/level3/pipe-tar" } }
	},
	sidesolid: { all: false },
	sideopaque: { all: false },
	collisionbox: { x1: 0, y1: 0.55, z1: 0, x2: 1, y2: 1, z2: 1 },
	selectionbox: { x1: 0, y1: 0.55, z1: 0, x2: 1, y2: 1, z2: 1 },
	collisionboxByType: { "*-hub": { x1: 0, y1: 0.5, z1: 0, x2: 1, y2: 1, z2: 1 } },
	selectionboxByType: { "*-hub": { x1: 0, y1: 0.5, z1: 0, x2: 1, y2: 1, z2: 1 } },
	lightAbsorption: 0,
	resistance: 3,
	soundsByType: {
		"*-leak-*": {
			place: "game:block/anvil1", break: "game:block/heavymetal-hit", hit: "game:block/heavymetal-hit",
			ambient: "backrooms:ambient/steam",
			ambientBlockCount: 2
		},
		"*": { place: "game:block/anvil1", break: "game:block/heavymetal-hit", hit: "game:block/heavymetal-hit" }
	},
	// Steam jets from a cracked joint in the rusty pipe. Particle positions are relative to the top centre of the block.
	particlePropertiesByType: {
		"*-leak-we": [{
			hsvaColor: [{ avg: 0, var: 0 }, { avg: 0, var: 0 }, { avg: 220, var: 20 }, { avg: 160, var: 40 }],
			opacityEvolve: { transform: "quadratic", factor: -16 },
			gravityEffect: { avg: -0.02, var: 0 },
			posOffset: [{ avg: 0, var: 0.1 }, { avg: -0.25, var: 0 }, { avg: 0.22, var: 0.05 }],
			velocity: [{ avg: 0, var: 0.3 }, { avg: -0.4, var: 0.15 }, { avg: 0, var: 0.3 }],
			quantity: { avg: 1.5 },
			size: { avg: 0.4, var: 0.15 },
			sizeEvolve: { transform: "linear", factor: 1.5 },
			particleModel: "Quad",
			lifeLength: { avg: 1.6, var: 0.4 },
			selfPropelled: true
		}],
		"*-leak-ns": [{
			hsvaColor: [{ avg: 0, var: 0 }, { avg: 0, var: 0 }, { avg: 220, var: 20 }, { avg: 160, var: 40 }],
			opacityEvolve: { transform: "quadratic", factor: -16 },
			gravityEffect: { avg: -0.02, var: 0 },
			posOffset: [{ avg: -0.22, var: 0.05 }, { avg: -0.25, var: 0 }, { avg: 0, var: 0.1 }],
			velocity: [{ avg: 0, var: 0.3 }, { avg: -0.4, var: 0.15 }, { avg: 0, var: 0.3 }],
			quantity: { avg: 1.5 },
			size: { avg: 0.4, var: 0.15 },
			sizeEvolve: { transform: "linear", factor: 1.5 },
			particleModel: "Quad",
			lifeLength: { avg: 1.6, var: 0.4 },
			selfPropelled: true
		}]
	}
}
