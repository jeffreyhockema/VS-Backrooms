{
	code: "wallpaper",
	variantgroups: [
		// "stripped" is bare drywall, left behind when the paper has been cut away
		// "red" is the paper of the Red Rooms, "cream" the pale paper of the arched areas
		{ code: "pattern", states: ["chevron", "dotted", "cream", "manila", "red", "stripped"] },
		// "upper" is a plain wall block; the others are the bottom block with its trim
		{ code: "part", states: ["upper", "plain", "baseboard", "rail", "outlet"] }
	],
	// A blade strips the paper off (for tinder and bindings), leaving the wall bare
	behaviors: [{ name: "BackroomsStrippable", properties: {
		result: "wallpaper-stripped-{part}", item: "wallpaperstrip",
		variant: "pattern", allowed: ["chevron", "dotted", "cream", "manila", "red"]
	} }],
	creativeinventory: { "general": ["*"], "construction": ["*"] },
	blockmaterial: "Stone",
	drawtype: "cube",
	// One stretch of wall in three is older and damp-stained; the other two are two hangings of the same paper.
	// The yellow paper (D1): one block in five is damp (its stain is the one mark that sits in the same place each
	// time), two in five carry a faint strip seam on their edge
	texturesByType: {
		"*-chevron-*": {
			all: { base: "block/wallpaper/{pattern}-{part}", alternates: [
				{ base: "block/wallpaper/{pattern}-{part}-2" },
				{ base: "block/wallpaper/{pattern}-{part}" },
				{ base: "block/wallpaper/{pattern}-{part}-2" },
				{ base: "block/wallpaper/{pattern}-{part}-damp" }
			] }
		},
		"*": {
			all: { base: "block/wallpaper/{pattern}-{part}", alternates: [
				{ base: "block/wallpaper/{pattern}-{part}-2" },
				{ base: "block/wallpaper/{pattern}-{part}-damp" }
			] }
		}
	},
	resistance: 2.5,
	lightAbsorption: 99,
	sounds: {
		walk: "game:walk/stone",
		place: "game:block/planks",
		break: "game:block/planks",
		hit: "game:block/planks"
	}
}
