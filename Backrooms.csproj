<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>backroomsss</AssemblyName>
    <RootNamespace>Backrooms</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>bin\$(Configuration)\Mods\backroomsss\</OutputPath>
    <!-- A Release build is zipped for players: no pdb in it -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- Where Vintage Story is installed: the VINTAGE_STORY environment variable, else the default install folder.
         To use another folder without editing this file, set VintageStory in Backrooms.csproj.user (git-ignored). -->
    <VintageStory Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStory>
    <VintageStory Condition="'$(VintageStory)' == ''">$(AppData)\Vintagestory</VintageStory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStory)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintageStory)\Mods\VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStory)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStory)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStory)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="worldconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="modicon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release builds also produce a distributable zip in bin\ -->
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="bin\backroomsss_$(Version).zip" Overwrite="true" />
  </Target>

  <PropertyGroup>
    <Version>0.610.0</Version>
  </PropertyGroup>

</Project>
